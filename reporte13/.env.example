# Google Cloud Storage
GCS_BUCKET_NAME=microservicio-libros
GCS_PROJECT_ID=tu-proyecto-id

# Credenciales de GCP (ruta al archivo JSON)
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/service-account-key.json

# API Token
API_TOKEN=tu_token_secreto

# MariaDB
DB_HOST=localhost
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_NAME=tu_base_datos
